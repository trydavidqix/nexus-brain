{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus.project-factory-request.v1",
  "title": "Nexus Project Factory Request",
  "type": "object",
  "required": ["project_id", "factory_run_id", "requested_by", "objective", "requirements", "constraints", "risk_level", "discovery_budget"],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "factory_run_id": { "type": "string", "minLength": 1 },
    "requested_by": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "risk_level": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "discovery_budget": {
      "type": "object",
      "required": ["max_queries", "max_candidates", "max_minutes"],
      "properties": {
        "max_queries": { "type": "integer", "minimum": 0 },
        "max_candidates": { "type": "integer", "minimum": 1 },
        "max_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "repository": {
      "type": "object",
      "properties": {
        "full_name": { "type": "string", "minLength": 1 },
        "default_branch": { "type": "string", "minLength": 1 }
      }
    }
  }
}
