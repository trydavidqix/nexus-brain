{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus.memory-record.v1",
  "title": "Nexus Canonical Memory Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["memory_id", "scope", "scope_id", "status", "content", "content_hash", "evidence_ids", "provenance", "temporal", "acl", "version"],
  "properties": {
    "memory_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["GLOBAL", "PROJECT", "SESSION", "TASK"] },
    "scope_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["OBSERVED", "CANDIDATE", "VERIFIED", "CANONICAL", "SUPERSEDED", "CONFLICTED", "REVOKED"] },
    "content": { "type": "string", "minLength": 1 },
    "content_hash": { "type": "string", "minLength": 1 },
    "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id", "actor_id"],
      "properties": {
        "source_type": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "actor_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "trace_id": { "type": "string", "minLength": 1 },
        "attributes": { "type": "object" }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "recorded_at", "valid_from"],
      "properties": {
        "observed_at": { "type": "string", "format": "date-time" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "valid_from": { "type": "string", "format": "date-time" },
        "valid_until": { "type": "string", "format": "date-time" }
      }
    },
    "acl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "read_permission_ids", "write_permission_ids"],
      "properties": {
        "policy_id": { "type": "string", "minLength": 1 },
        "read_permission_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "write_permission_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "task_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "supersedes": { "type": "string", "minLength": 1 },
    "superseded_by": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 }
  }
}
