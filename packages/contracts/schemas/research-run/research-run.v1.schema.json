{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus.research-run.v1",
  "title": "Nexus Completed Research Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "project_id", "task_id", "agent_id", "status", "started_at", "completed_at", "evidence_ids", "warnings", "limits", "budget", "provenance"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["OK", "EMPTY", "PARTIAL", "DEGRADED", "BLOCKED", "TIMEOUT"] },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_queries", "max_providers", "max_results_per_provider", "max_browser_escalations", "max_wall_time_seconds"],
      "properties": {
        "max_queries": { "type": "integer", "minimum": 1 },
        "max_providers": { "type": "integer", "minimum": 1 },
        "max_results_per_provider": { "type": "integer", "minimum": 1 },
        "max_browser_escalations": { "type": "integer", "minimum": 0 },
        "max_wall_time_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "budget": { "type": "object" },
    "provenance": { "type": "object" },
    "summary": { "type": "string" }
  }
}
