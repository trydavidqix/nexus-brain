{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus.project-factory-plan.v1",
  "title": "Nexus Project Factory Plan",
  "type": "object",
  "required": ["project_id", "factory_run_id", "status", "discovery_evidence_ids", "architecture_decisions", "resource_decisions", "task_graph", "completion_gates", "human_gates"],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "factory_run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PLANNED", "READY", "BLOCKED"] },
    "discovery_evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "architecture_decisions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "resource_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "disposition", "reason", "evidence_ids"],
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["REUSE", "USE_PROVIDER", "ADAPT", "BUILD"] },
          "implementation": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "task_graph": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "objective", "depends_on", "acceptance_criteria", "required_capabilities"],
        "properties": {
          "task_id": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "depends_on": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "required_capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "completion_gates": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "human_gates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "blocked_by": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
