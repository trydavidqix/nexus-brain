{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nexus.maestri-decision-input.v1",
  "title": "Nexus Maestri Decision Input",
  "type": "object",
  "required": ["project_id", "task_id", "agent_id", "decision_id", "risk", "priority", "policy", "signals", "evidence_refs"],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "decision_id": { "type": "string", "minLength": 1 },
    "proposed_route": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "priority": { "type": "integer", "minimum": 0 },
    "policy": {
      "type": "object",
      "required": ["denied", "approval_required"],
      "properties": {
        "denied": { "type": "boolean" },
        "approval_required": { "type": "boolean" },
        "ceo_required": { "type": "boolean" },
        "retry_allowed": { "type": "boolean" },
        "confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence_threshold_version": { "type": "string", "minLength": 1 }
      }
    },
    "signals": {
      "type": "object",
      "required": ["exact"],
      "properties": {
        "exact": { "type": "boolean" },
        "conflict": { "type": "boolean" },
        "unsupported": { "type": "boolean" },
        "calibrated_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
